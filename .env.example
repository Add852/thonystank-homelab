# Device-specific values — copy to .env and adjust per machine.
# .env is gitignored; config.yaml references these as ${...}.

# Obsidian folders (absolute paths — vault structure may differ per device)
NOTES_DIR=/home/tony/SyncProxmox/ObsidianVaults/GroundZero/1 Everything/0 Notes
CONTENTS_DIR=/home/tony/SyncProxmox/ObsidianVaults/GroundZero/1 Everything/2 Contents
ATTACHMENTS_DIR=/home/tony/SyncProxmox/ObsidianVaults/GroundZero/4 Files

# Absolute path to the resume PDF shown on /about (leave unset to hide section)
RESUME_PATH=/home/tony/SyncFedora/Documents/Resumes/Resume_LaTeX.pdf

# Optional: GitHub token for the contributions graph + "Contributed to" section.
# Without it (or without an authenticated `gh` CLI on this device), those two
# sections stay empty. Create at github.com/settings/tokens (no scopes needed
# for public data).
# GITHUB_TOKEN=github_pat_xxxx
